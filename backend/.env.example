# ---- Application ----
APP_NAME=College Chatbot API
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Database (MySQL 8) ----
DATABASE_URL=mysql+pymysql://college_user:CHANGE_ME@localhost:3306/college_chatbot

# ---- Security ----
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ---- Rate limiting (requests per window, window in seconds) ----
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# ---- First admin (used only by: python -m app.scripts.create_admin) ----
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=Admin#2025
FIRST_ADMIN_NAME=System Administrator

# ---- RAG ----
UPLOAD_DIR=storage/uploads
CHROMA_DIR=storage/chroma
MAX_UPLOAD_MB=20
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=8
# Cosine similarity 0..1. Chunks scoring below this are discarded. Tune with your real documents.
SIMILARITY_THRESHOLD=0.20
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Groq ----
# Free key: https://console.groq.com  (never commit it)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30

# ---- Chat ----
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60

# Load the embedding model in the background at startup (recommended)
PRELOAD_EMBEDDING_MODEL=true
